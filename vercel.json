{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci --no-fund --no-audit && npm run build",
  "functions": {
    "main.py": {
      "excludeFiles": "{frontend/node_modules/**,frontend/src/**,docs/**,backend/tests/**,backend/scripts/**,**/.venv/**,**/__pycache__/**,**/*.md}"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
